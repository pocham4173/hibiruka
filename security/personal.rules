    // HIBIRUKA_PERSONAL_V1_BEGIN
    function personalOwner(data) {
      return request.auth != null && data.ownerUid == request.auth.uid;
    }
    match /personalConfig/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ownerName', 'cats', 'people', 'selfFriendId', 'createdAt', 'version', 'calendar'])
        && (!('calendar' in request.resource.data) || validCalendar(request.resource.data.calendar))
        && (!exists(/databases/$(database)/documents/personalConfig/$(uid))
          || !('calendar' in resource.data) || !('business' in resource.data.calendar)
          || ('calendar' in request.resource.data && 'business' in request.resource.data.calendar));
    }
    function validCalendar(c) {
      return c is map && c.keys().hasOnly(['version','configured','team','showRokuyo','days','business'])
        && c.keys().hasAll(['version','configured','team','showRokuyo','days'])
        && c.version == 1 && c.configured is bool && c.team in ['','A','B','C1','C2','C3','C4','C5','C6','C7','C8']
        && c.showRokuyo is bool && c.days is map && c.days.size() <= 1200
        && (!('business' in c) || validBusinessCalendar(c.business));
    }
    function validBusinessCalendar(b) {
      return b is map && b.keys().hasOnly(['version','yearStart','leaveStart','confirmedFrom','confirmedThrough','labels','personal','entries'])
        && b.keys().hasAll(['version','yearStart','leaveStart','confirmedFrom','confirmedThrough','labels','personal','entries'])
        && b.version == 1 && b.yearStart is string && b.yearStart.matches('^[0-9]{2}-[0-9]{2}$')
        && b.leaveStart is string && b.leaveStart.matches('^[0-9]{2}-[0-9]{2}$')
        && b.confirmedFrom is string && b.confirmedThrough is string
        && b.confirmedFrom.size() <= 10 && b.confirmedThrough.size() <= 10
        && b.labels is map && b.labels.size() <= 13
        && b.personal is map && b.personal.size() <= 1200
        && b.entries is map && b.entries.size() <= 500;
    }
    match /personalPets/{id} {
      allow list: if personalOwner(resource.data);
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/personalPets/$(id)) || personalOwner(resource.data));
      allow delete: if personalOwner(resource.data);
      allow create, update: if personalOwner(request.resource.data)
        && (!exists(/databases/$(database)/documents/personalPets/$(id)) || personalOwner(resource.data))
        && request.resource.data.keys().hasOnly(['ownerUid','name','breed','sex','birthday','welcome','birthdayEstimated','welcomeEstimated','photo','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid','name','breed','sex','birthday','welcome','birthdayEstimated','welcomeEstimated','photo','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.breed is string && request.resource.data.breed.size() <= 60
        && request.resource.data.sex in ['','男の子','女の子','不明']
        && petDate(request.resource.data.birthday) && petDate(request.resource.data.welcome)
        && request.resource.data.birthdayEstimated is bool && request.resource.data.welcomeEstimated is bool
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 100000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/personalPets/$(id)) && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/personalPets/$(id)) && request.resource.data.createdAt == resource.data.createdAt));
    }
    // Earlier shared records: follow the live isOwner() policy, including already registered devices.
    // Do not invent PIN revocation rules or grant access to personal-only users.
    match /pets/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.ownerUid is string
        && ((!exists(/databases/$(database)/documents/pets/$(id)) && personalOwner(request.resource.data))
          || (exists(/databases/$(database)/documents/pets/$(id)) && request.resource.data.ownerUid == resource.data.ownerUid))
        && request.resource.data.keys().hasOnly(['ownerUid','name','breed','sex','birthday','welcome','birthdayEstimated','welcomeEstimated','photo','createdAt','updatedAt'])
        && request.resource.data.keys().hasAll(['ownerUid','name','breed','sex','birthday','welcome','birthdayEstimated','welcomeEstimated','photo','createdAt','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.breed is string && request.resource.data.breed.size() <= 60
        && request.resource.data.sex in ['','男の子','女の子','不明']
        && petDate(request.resource.data.birthday) && petDate(request.resource.data.welcome)
        && request.resource.data.birthdayEstimated is bool && request.resource.data.welcomeEstimated is bool
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 100000
        && (request.resource.data.photo == '' || request.resource.data.photo.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))
        && request.resource.data.updatedAt == request.time
        && ((!exists(/databases/$(database)/documents/pets/$(id)) && request.resource.data.createdAt == request.time)
          || (exists(/databases/$(database)/documents/pets/$(id)) && request.resource.data.createdAt == resource.data.createdAt));
    }
    function petDate(d) { return d is string && (d == '' || d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')); }
    function validPetEvent(d) {
      return (!('petIds' in d) || (d.petIds is list && d.petIds.size() <= 20))
        && (!('petCareType' in d) || d.petCareType in ['','思い出','体重','薬','ワクチン','通院','トリミング'])
        && (!('petWeightKg' in d) || d.petWeightKg == null || (d.petWeightKg is number && d.petWeightKg > 0 && d.petWeightKg <= 200))
        && (!('petHidden' in d) || (d.petHidden is bool && (!d.petHidden || d.get('nextSendAt',null) == null)));
    }
    // 通知の予約（2026-10-09）：送信状態・通数・処理中の印はサーバーだけが書く。
    // 本人ができるのは「予約を1件、末尾に足す」と「取り消しの申し出を1件足す」だけ（既存の行は変えられない）。
    function sendFieldsUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sends', 'nextSendAt', 'sendCancels', 'schedulerError']);
    }
    function validNewSend(item) {
      return item is map
        && item.keys().hasOnly(['id', 'at', 'friendIds', 'from', 'note', 'status'])
        && item.keys().hasAll(['id', 'at', 'friendIds', 'status'])
        && item.status == 'wait'
        && item.id is string && item.id.matches('^[A-Za-z0-9-]{8,64}$')
        && item.at is string && item.at.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && item.friendIds is list && item.friendIds.size() >= 1 && item.friendIds.size() <= 20
        && (!('from' in item) || (item.from is string && item.from.size() <= 40))
        && (!('note' in item) || (item.note is string && item.note.size() <= 100));
    }
    function appendsOneSend() {
      let old = resource.data.get('sends', []);
      let neu = request.resource.data.get('sends', []);
      let n = old.size();
      let before = resource.data.get('nextSendAt', null);
      let after = request.resource.data.get('nextSendAt', null);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sends', 'nextSendAt', 'updatedAt'])
        && n < 40 && neu.size() == n + 1 && (n == 0 || neu[0:n] == old)
        && validNewSend(neu[n])
        && ((before == null && after == neu[n].at)
          || (before != null && neu[n].at < before && after == neu[n].at)
          || (before != null && neu[n].at >= before && after == before));
    }
    function appendsOneCancel() {
      let old = resource.data.get('sendCancels', []);
      let neu = request.resource.data.get('sendCancels', []);
      let n = old.size();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sendCancels', 'updatedAt'])
        && n < 40 && neu.size() == n + 1 && (n == 0 || neu[0:n] == old)
        && neu[n] is string && neu[n].matches('^[A-Za-z0-9-]{1,64}$');
    }
    match /personalEvents/{id} {
      allow read, delete: if personalOwner(resource.data);
      allow create: if personalOwner(request.resource.data) && validPetEvent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('sends', []) == []
        && request.resource.data.get('nextSendAt', null) == null
        && !request.resource.data.keys().hasAny(['sendCancels', 'schedulerError']);
      allow update: if personalOwner(resource.data) && personalOwner(request.resource.data) && validPetEvent(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (sendFieldsUntouched() || appendsOneSend() || appendsOneCancel());
    }
    match /personalPhotos/{id} {
      allow read, delete: if personalOwner(resource.data);
      allow create, update: if personalOwner(request.resource.data)
        && (!exists(/databases/$(database)/documents/personalPhotos/$(id)) || personalOwner(resource.data))
        && personalOwner(getAfter(/databases/$(database)/documents/personalEvents/$(request.resource.data.eventId)).data);
    }
    match /personalFriends/{id} {
      allow list: if personalOwner(resource.data);
      allow get: if request.auth != null && (personalOwner(resource.data)
        || resource.data.status == 'pending'
        || resource.data.get('acceptedBy', '') == request.auth.uid);
      allow create: if personalOwner(request.resource.data)
        && request.resource.data.keys().hasOnly(['ownerUid','name','status','from','createdAt'])
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time;
      allow delete: if personalOwner(resource.data);
      allow update: if personalOwner(resource.data) && personalOwner(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','from','sentAt','sentCount']);
      // 招待の承認（pending → joined）は、LINEの本人確認をしたサーバーだけが書く（2026-10）。ブラウザからは書けない。
    }
    // LINEの通数（2026-10）：数えるのはサーバーだけ。本人は自分の今月の数を、だれでも全体の残りの数だけを読める
    match /lineUsage/{id} {
      allow get: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }
    match /lineQuota/{id} {
      allow get: if request.auth != null;
    }
    // 導線の計測（2026-10-09）：日ごとの合計だけ。1回に1つ増やすことだけができ、だれも読めない（集計はサーバー側で読む）
    match /routeStats/{id} {
      allow create: if request.auth != null && id.matches('^(hp_plan|rk_stay)_[0-9]{8}$')
        && request.resource.data.route + '_' + request.resource.data.day == id
        && ((request.resource.data.keys().hasOnly(['route', 'day', 'shown']) && request.resource.data.shown == 1)
          || (request.resource.data.keys().hasOnly(['route', 'day', 'clicks']) && request.resource.data.clicks == 1));
      allow update: if request.auth != null
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shown']) && request.resource.data.shown == resource.data.get('shown', 0) + 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) && request.resource.data.clicks == resource.data.get('clicks', 0) + 1));
    }
    // sendLedger（送信台帳：確保した通数・処理中の印・手段ごとの結果）はサーバー専用。ここに許可を書かない＝だれも読み書きできない。
    // LINE連携（2026-10）: アプリで作る使い捨て番号と、連携状態の確認・解除。
    // lineAccounts（LINEの人→持ち主）はサーバー専用で、利用者は読み書きできない。
    match /lineLinkCodes/{code} {
      allow get, delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null && code.matches('^[A-HJ-NP-Z2-9]{10}$')
        && request.resource.data.keys().hasOnly(['ownerUid','scope','expiresAt','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(11, 'm')
        && ((request.resource.data.scope == 'personal'
              && exists(/databases/$(database)/documents/personalConfig/$(request.auth.uid)))
          || (request.resource.data.scope == 'legacy' && isOwner()));
    }
    match /lineLinks/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
    }
    // HIBIRUKA_PERSONAL_V1_END
